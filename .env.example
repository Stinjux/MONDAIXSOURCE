# ---------------------------------------------------------------------------
# MONDAIX SOURCE — variables d'environnement (à définir dans Railway → Variables)
# Ne jamais committer de vraies valeurs. Aucune variable n'est exposée au navigateur.
# ---------------------------------------------------------------------------

# PostgreSQL Railway (référence : ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Mot de passe du dashboard (long et aléatoire). Le changer déconnecte toutes les sessions.
ADMIN_PASSWORD=""

# Jeton distinct pour les tâches planifiées : POST /api/sync et /api/reminder
SYNC_SECRET=""

# Fichier JSON du compte de service Google, encodé en base64 :  base64 -w0 service-account.json
# Partager les deux Sheets en lecture avec le "client_email" de ce compte.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""

# Sheet LEADS (colonnes A à J) — l'ID est dans l'URL : docs.google.com/spreadsheets/d/<ID>/edit
LEADS_SHEET_ID=""
LEADS_SHEET_RANGE="LEADS!A:J"

# Sheet OUT OF STOCK (colonnes A à P)
OOS_SHEET_ID=""
OOS_SHEET_RANGE="'OUT OF STOCK'!A:P"

# --- Optionnel ---
# Objectif hebdomadaire de nouveaux leads uniques (défaut 50)
WEEKLY_LEAD_GOAL="50"
# Dates ambiguës comme 03/04/2026 : MDY (défaut) ou DMY
SHEET_DATE_ORDER="MDY"
# Jours avant qu'une vérification OUT OF STOCK soit considérée périmée (défaut 7)
OOS_RECHECK_DAYS="7"
# Webhook Slack / Discord / ntfy pour le rappel de la Weekly Review
REMINDER_WEBHOOK_URL=""
# Tests d'intégration uniquement (le nom de la base doit contenir « test »)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mondaix_test"
